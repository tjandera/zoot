# ── Zoot environment ─────────────────────────────────────────────
# Copy to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Every key is optional. With none set, the app runs in Guest mode
# (localStorage data + deterministic planner), so the demo never dies.

# Supabase (Kayra + Steven). Public by design; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq (server-only, read by /api/plan and /api/summary). Never prefix with VITE_.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OneMap routing (server-only, read by /api/route and `npm run routes:gen`). Never prefix with VITE_.
# ONEMAP_TOKEN is optional (tokens last ~3 days); with EMAIL + PASSWORD the server renews it itself.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_TOKEN=

# Show the /dev god-mode panel (fake GPS, skip time, force rain) in production builds.
# Always on in `npm run dev`. Set to 1 on the grading deployment so the instructor can fake-walk.
VITE_DEV_PANEL=1
